<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
	<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>enable</Nullable>
    <Title>$(AssemblyName)</Title>
  </PropertyGroup>

  <PropertyGroup Label="Package">
	<PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Title>Telegram Navigation</Title>
    <Description>TelegramNavigation is .NET library based on .NET Client for Telegram Bot API to enchance creating navigation and multi-level telegram menus experience.</Description>
    <PackageId>TelegramNavigation</PackageId>
    <Authors>ST0PL</Authors>
    <Copyright>Copyright © ST0PL 2026</Copyright>
    <Version>4.0.4</Version>
    <PackageProjectUrl>https://github.com/ST0PL/TelegramNavigation</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/ST0PL/TelegramNavigation.git</RepositoryUrl>
    <PackageTags>Telegram;Bot;Inline</PackageTags>
    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
    <PackageReleaseNotes>Updated packages, created TelegramNavigation.Hooks namespace for InlineQueryHook and MesssageHook, used collection and target-typed new expressions</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Telegram.Bot" Version="22.10.1.1" />
  </ItemGroup>
  <ItemGroup>
	  <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
